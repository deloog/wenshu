{
  "name": "@wenshu/ux-state",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./data": "./src/data.ts",
    "./import-flow": "./src/import-flow.ts"
  },
  "wenshu": {
    "generatedFiles": [
      "src/generated/ux-states.ts"
    ]
  },
  "scripts": {
    "generate": "node scripts/generate-types.ts",
    "generate:check": "node scripts/check-generated.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@wenshu/contract-runtime": "workspace:*",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "typescript": "catalog:"
  }
}
