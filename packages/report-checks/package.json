{
  "name": "@wenshu/report-checks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "wenshu": {
    "generatedFiles": [
      "src/generated/check-report.ts"
    ]
  },
  "scripts": {
    "generate": "node scripts/generate-types.ts",
    "generate:check": "node scripts/check-generated.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@wenshu/contract-runtime": "workspace:*",
    "@wenshu/document-model": "workspace:*",
    "@wenshu/pdf-evidence": "workspace:*",
    "@wenshu/pdf-export": "workspace:*",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wenshu/markdown-import": "workspace:*",
    "json-schema-to-typescript": "catalog:",
    "typescript": "catalog:"
  }
}
