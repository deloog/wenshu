{
  "name": "wenshu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.17.0",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "pnpm --filter @wenshu/web dev",
    "build": "pnpm -r --if-present run build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "quality:check": "pnpm --filter @wenshu/quality check",
    "config:check": "pnpm --filter @wenshu/config test",
    "generated:check": "pnpm -r --if-present run generate:check",
    "contracts:test": "pnpm --filter @wenshu/contract-runtime test && pnpm --filter @wenshu/document-model test && pnpm --filter @wenshu/template-model test && pnpm --filter @wenshu/host-contract test && pnpm --filter @wenshu/project-contract test",
    "contracts:check": "pnpm generated:check && pnpm contracts:test",
    "fixtures:check": "pnpm --filter @wenshu/fixtures check",
    "fonts:check": "pnpm --filter @wenshu/fonts check",
    "environment:check": "pnpm --filter @wenshu/environment check",
    "env:record": "pnpm --filter @wenshu/environment record",
    "supply:check": "pnpm --filter @wenshu/supply-chain check",
    "sbom:build": "pnpm --filter @wenshu/supply-chain build:sbom",
    "test:layers": "pnpm --filter @wenshu/test-support layers:check",
    "test:unit": "node packages/test-support/scripts/run-test-layer.ts unit",
    "test:contract": "node packages/test-support/scripts/run-test-layer.ts contract",
    "test:render": "node packages/test-support/scripts/run-test-layer.ts render",
    "test:integration": "node packages/test-support/scripts/run-test-layer.ts integration",
    "test:e2e": "node packages/test-support/scripts/run-test-layer.ts e2e",
    "test:foundation": "pnpm test:layers && pnpm test:unit",
    "secrets:check": "node tools/ci/scripts/check-secrets.ts",
    "licenses:check": "node tools/ci/scripts/check-licenses.ts",
    "ci:job": "node tools/ci/scripts/run-job.ts",
    "ci:verify": "node tools/ci/scripts/run-parallel.ts",
    "typecheck": "pnpm -r --if-present run typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm quality:check && pnpm test:foundation && pnpm config:check && pnpm contracts:check && pnpm fixtures:check && pnpm fonts:check && pnpm environment:check && pnpm supply:check && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  }
}
