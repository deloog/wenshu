{
  "name": "wenshu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.17.0",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "pnpm --filter @wenshu/web dev",
    "build": "pnpm -r --if-present run build",
    "config:check": "pnpm --filter @wenshu/config test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "verify": "pnpm config:check && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
